{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sed \"s#\\${CLAUDE_PLUGIN_ROOT}#${CLAUDE_PLUGIN_ROOT}#g\" \"${CLAUDE_PLUGIN_ROOT}/hooks/context.md\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/recall.js\""
          }
        ]
      }
    ]
  }
}
